# Atelier Elite - Environment Variables Template

# Database Connection String
# For local development with SQLite:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL / Supabase:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Authentication Secret (Generate a strong random string for production)
JWT_SECRET="replace_with_a_secure_random_64_character_string_in_production"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Store Configuration Defaults
NEXT_PUBLIC_STORE_NAME="ATELIER ÉLITE"
NEXT_PUBLIC_STORE_CURRENCY="INR"
NEXT_PUBLIC_STORE_CURRENCY_SYMBOL="₹"

# Razorpay Payment Gateway (Available from Razorpay Dashboard -> Settings -> API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Optional: Transactional Email via Resend
RESEND_API_KEY="re_123456789"
EMAIL_FROM="orders@yourdomain.com"
