# Environment Configuration

# Database: SQLite for instant local dev; swap with PostgreSQL/Supabase URL in production
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET="atelier_production_ready_jwt_secret_token_secure_2026_xyz"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Store Settings
NEXT_PUBLIC_STORE_NAME="ATELIER ÉLITE"
NEXT_PUBLIC_STORE_CURRENCY="INR"
NEXT_PUBLIC_STORE_CURRENCY_SYMBOL="₹"

# Razorpay Payment Gateway (Test credentials or leave default for seamless simulated sandbox)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Email Provider (Optional: Resend or SMTP)
RESEND_API_KEY=""
EMAIL_FROM="orders@atelier-elite.com"
